<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!--
    Pinned to the version ProjectSpy.Core compiles against (2.5.187).

    Core has a PackageReference on MessagePack 2.5.187. These NuGet entries are what makes
    that assembly exist inside Unity, via NuGetForUnity. They were previously floating at
    3.1.10, which put two different MessagePack builds into the project at once: this one,
    and the copy tools/sync-dlls.ps1 was publishing from Core's own output. Two assemblies
    of the same name is a hard conflict, and a version Core was never compiled against is a
    silent one.

    Keep these in step with the PackageReference in src/ProjectSpy.Core/ProjectSpy.Core.csproj.
    If that version changes, change it here too, and re-run tools/sync-dlls.ps1.
  -->
  <package id="MessagePack" version="2.5.187" manuallyInstalled="true" />
  <package id="MessagePack.Annotations" version="2.5.187" manuallyInstalled="true" />
  <package id="MessagePackAnalyzer" version="2.5.187" manuallyInstalled="true" />
  <package id="Microsoft.NET.StringTools" version="17.6.3" manuallyInstalled="true" />
</packages>
